<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>dev.foresterworkload</groupId>
  <artifactId>forester-aot-workload</artifactId>
  <version>1.0-SNAPSHOT</version>
  <packaging>jar</packaging>

  <!--
    Custom AOT recording workload for forester 1.039.

    Forester has no usable JUnit test suite (it ships manual test scripts),
    so class loading is driven by a small main-class workload that exercises
    the core phylogenetics types on the biojava-alignment code path.

    openchart is excluded: it lives in a dead JBoss repository and is only
    needed by the unused GUI phylogenetics path; the pairwise-alignment
    code path the benchmark exercises does not call it.

    To record the cache:
      mvn package
      java -XX:AOTCacheOutput=cache.aot -jar target/forester-workload-fat.jar
  -->

  <properties>
    <maven.compiler.release>11</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <repositories>
    <repository>
      <id>biojava-thirdparty</id>
      <url>https://github.com/biojava/biojava-thirdparty/raw/master/</url>
    </repository>
  </repositories>

  <dependencies>
    <dependency>
      <groupId>org.biojava.thirdparty</groupId>
      <artifactId>forester</artifactId>
      <version>1.039</version>
      <exclusions>
        <!-- openchart lives in a dead JBoss repo and is never on the
             pairwise-alignment code path; excluded to keep the classpath clean. -->
        <exclusion>
          <groupId>openchart</groupId>
          <artifactId>openchart</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>commons-codec</groupId>
      <artifactId>commons-codec</artifactId>
      <version>1.5</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <finalName>forester-workload-fat</finalName>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>dev.foresterworkload.ForesterWorkload</mainClass>
                </transformer>
              </transformers>
              <createDependencyReducedPom>false</createDependencyReducedPom>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
