From 8682fb2adb4bec9ba9fb62cad57bedb48ff720a3 Mon Sep 17 00:00:00 2001
From: Aman Sharma <mannu.poski10@gmail.com>
Date: Tue, 9 Jun 2026 09:34:10 +0200
Subject: [PATCH 1/3] Add tree-merge Maven profile for AOT cache recording

Adds a tree-merge profile to opennlp-tools that runs the full test
suite under -XX:AOTCacheOutput to record a tree-covering AOT cache.
Key differences from the default surefire config:
- forkCount=1 to avoid concurrent writes to the same cache file
- Drops the junit5-system-exit javaagent (bytecode instrumentation
  would distort the recorded class set)
- Excludes cmdline/** tests that call System.exit() directly
- Adds --add-modules java.instrument and --add-opens needed by AOT

Co-Authored-By: Claude Sonnet 4.6 <noreply@anthropic.com>
Signed-off-by: Aman Sharma <mannu.poski10@gmail.com>
---
 opennlp-tools/pom.xml | 31 +++++++++++++++++++++++++++++++
 1 file changed, 31 insertions(+)

diff --git a/opennlp-tools/pom.xml b/opennlp-tools/pom.xml
index bf5810a1..8c7f5966 100644
--- a/opennlp-tools/pom.xml
+++ b/opennlp-tools/pom.xml
@@ -142,6 +142,37 @@
   </build>
 
   <profiles>
+    <profile>
+      <id>tree-merge</id>
+      <activation>
+        <jdk>[21,)</jdk>
+      </activation>
+      <build>
+        <plugins>
+          <plugin>
+            <groupId>org.apache.maven.plugins</groupId>
+            <artifactId>maven-surefire-plugin</artifactId>
+            <configuration>
+              <!--
+                Drop the junit5-system-exit javaagent (bytecode instrumentation)
+                and exclude cmdline tests that call System.exit() directly.
+                forkCount=1 prevents multiple forked JVMs racing to write the
+                same AOTCacheOutput file.
+              -->
+              <forkCount>1</forkCount>
+              <argLine>-Xmx2048m -DOPENNLP_DOWNLOAD_HOME=${opennlp.download.home} --add-modules java.instrument --add-opens java.base/java.io=ALL-UNNAMED --add-opens java.base/java.lang=ALL-UNNAMED --add-opens java.base/java.lang.reflect=ALL-UNNAMED --add-opens java.base/java.util=ALL-UNNAMED -Xlog:aot+map=trace,aot+map+oops=trace,aot=warning:file=aot.map:none:filesize=0 -XX:AOTCacheOutput=${project.basedir}/cache.aot</argLine>
+              <excludes>
+                <exclude>**/stemmer/*</exclude>
+                <exclude>**/stemmer/snowball/*</exclude>
+                <exclude>**/*IT.java</exclude>
+                <exclude>**/cmdline/**</exclude>
+              </excludes>
+            </configuration>
+          </plugin>
+        </plugins>
+      </build>
+    </profile>
+
     <profile>
       <id>jmh</id>
       <dependencies>
-- 
2.49.0


