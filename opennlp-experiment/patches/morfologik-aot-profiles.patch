From 4879821d2795ca298c489852b871e62b9cca339d Mon Sep 17 00:00:00 2001
From: Aman Sharma <mannu.poski10@gmail.com>
Date: Tue, 9 Jun 2026 11:09:19 +0200
Subject: [PATCH 3/4] Upgrade surefire to 3.5.2 in tree-merge profile for JDK
 21+ compatibility

Signed-off-by: Aman Sharma <mannu.poski10@gmail.com>
---
 pom.xml | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/pom.xml b/pom.xml
index ac29593..1ec6190 100644
--- a/pom.xml
+++ b/pom.xml
@@ -774,8 +774,10 @@
           <plugin>
             <groupId>org.apache.maven.plugins</groupId>
             <artifactId>maven-surefire-plugin</artifactId>
+            <version>3.5.2</version>
             <configuration>
               <forkCount>1</forkCount>
+              <reuseForks>true</reuseForks>
               <argLine>-Xmx2048m --add-opens java.base/java.io=ALL-UNNAMED --add-opens java.base/java.lang=ALL-UNNAMED --add-opens java.base/java.lang.reflect=ALL-UNNAMED --add-opens java.base/java.util=ALL-UNNAMED --add-opens java.base/jdk.internal.loader=ALL-UNNAMED -Xlog:aot+map=trace,aot+map+oops=trace,aot=warning:file=aot.map:none:filesize=0 -XX:AOTCacheOutput=${project.basedir}/cache.aot</argLine>
             </configuration>
           </plugin>
-- 
2.49.0


From 4d874a7c10f281b153eb1fdfd2db601b30470326 Mon Sep 17 00:00:00 2001
From: Aman Sharma <mannu.poski10@gmail.com>
Date: Tue, 9 Jun 2026 11:15:58 +0200
Subject: [PATCH 4/4] Fix tree-merge: configure junit4-maven-plugin with
 parallelism=1 and AOT argLine

Signed-off-by: Aman Sharma <mannu.poski10@gmail.com>
---
 pom.xml | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/pom.xml b/pom.xml
index 1ec6190..63ec1e7 100644
--- a/pom.xml
+++ b/pom.xml
@@ -771,6 +771,7 @@
       </activation>
       <build>
         <plugins>
+          <!-- surefire fallback for modules without randomizedtesting.enabled -->
           <plugin>
             <groupId>org.apache.maven.plugins</groupId>
             <artifactId>maven-surefire-plugin</artifactId>
@@ -781,6 +782,15 @@
               <argLine>-Xmx2048m --add-opens java.base/java.io=ALL-UNNAMED --add-opens java.base/java.lang=ALL-UNNAMED --add-opens java.base/java.lang.reflect=ALL-UNNAMED --add-opens java.base/java.util=ALL-UNNAMED --add-opens java.base/jdk.internal.loader=ALL-UNNAMED -Xlog:aot+map=trace,aot+map+oops=trace,aot=warning:file=aot.map:none:filesize=0 -XX:AOTCacheOutput=${project.basedir}/cache.aot</argLine>
             </configuration>
           </plugin>
+          <!-- primary test runner when profile.randomizedtesting is active -->
+          <plugin>
+            <groupId>com.carrotsearch.randomizedtesting</groupId>
+            <artifactId>junit4-maven-plugin</artifactId>
+            <configuration>
+              <parallelism>1</parallelism>
+              <argLine>-Xmx2048m --add-opens java.base/java.io=ALL-UNNAMED --add-opens java.base/java.lang=ALL-UNNAMED --add-opens java.base/java.lang.reflect=ALL-UNNAMED --add-opens java.base/java.util=ALL-UNNAMED --add-opens java.base/jdk.internal.loader=ALL-UNNAMED -Xlog:aot+map=trace,aot+map+oops=trace,aot=warning:file=aot.map:none:filesize=0 -XX:AOTCacheOutput=${project.basedir}/cache.aot</argLine>
+            </configuration>
+          </plugin>
         </plugins>
       </build>
     </profile>
-- 
2.49.0

