From 5a0c758be4785e379d0ed695a7bb81474e9ec117 Mon Sep 17 00:00:00 2001
From: Aman Sharma <mannu.poski10@gmail.com>
Date: Tue, 9 Jun 2026 10:58:12 +0200
Subject: [PATCH 1/4] Add tree-merge AOT profile

Signed-off-by: Aman Sharma <mannu.poski10@gmail.com>
---
 pom.xml | 21 ++++++++++++++++++++-
 1 file changed, 20 insertions(+), 1 deletion(-)

diff --git a/pom.xml b/pom.xml
index ee9343e..1efc859 100644
--- a/pom.xml
+++ b/pom.xml
@@ -762,7 +762,26 @@
           </plugin>
         </plugins>
       </build>
-    </profile>    
+    </profile>
+
+    <profile>
+      <id>tree-merge</id>
+      <activation>
+        <jdk>[21,)</jdk>
+      </activation>
+      <build>
+        <plugins>
+          <plugin>
+            <groupId>org.apache.maven.plugins</groupId>
+            <artifactId>maven-surefire-plugin</artifactId>
+            <configuration>
+              <forkCount>1</forkCount>
+              <argLine>-Xmx2048m --add-opens java.base/java.io=ALL-UNNAMED --add-opens java.base/java.lang=ALL-UNNAMED --add-opens java.base/java.lang.reflect=ALL-UNNAMED --add-opens java.base/java.util=ALL-UNNAMED --add-opens java.base/jdk.internal.loader=ALL-UNNAMED -Xlog:aot+map=trace,aot+map+oops=trace,aot=warning:file=aot.map:none:filesize=0 -XX:AOTCacheOutput=${project.basedir}/cache.aot</argLine>
+            </configuration>
+          </plugin>
+        </plugins>
+      </build>
+    </profile>
   </profiles>
 </project>
 
-- 
2.49.0


